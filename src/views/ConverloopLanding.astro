---
import ConverloopLayout from '../layouts/ConverloopLayout.astro';
import { CONVERLOOP } from '../consts';
import { getUi } from '../i18n';

const t = getUi(Astro.currentLocale);
const c = t.converloop;
const l = c.launch;
const d = c.demo;
const s = c.showcase;
const reply = s.reply;
---

<ConverloopLayout title={`${CONVERLOOP.name} — ${c.tagline}`} description={c.metaDescription}>
	<section class="cl2-hero">
		<div class="cl2-glow cl2-glow--one" aria-hidden="true"></div>
		<div class="cl2-glow cl2-glow--two" aria-hidden="true"></div>
		<div class="cl2-shell cl2-hero-grid">
			<div class="cl2-hero-copy">
				<div class="cl2-brand">
					<img src="/converloop-icon.png" width="52" height="52" alt="" />
					<span>{CONVERLOOP.name}</span>
				</div>
				<p class="cl2-status"><span aria-hidden="true"></span>{l.status}</p>
				<p class="cl2-eyebrow">{l.heroEyebrow}</p>
				<h1 aria-label={`${l.heroTitle} ${l.heroAccent}`}>
					{l.heroTitle}<br /><span>{l.heroAccent}</span>
				</h1>
				<p class="cl2-hero-body">{l.heroBody}</p>
				<div class="cl2-actions">
					<a class="cl2-button cl2-button--primary" href={CONVERLOOP.releaseUrl} target="_blank" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14" /></svg>
						<span><strong>{l.download}</strong><small>{l.downloadNote}</small></span>
					</a>
					<a class="cl2-button cl2-button--secondary" href={CONVERLOOP.repoUrl} target="_blank" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l6-6-6-6M9 6l-6 6 6 6" /></svg>
						<strong>{l.source}</strong>
					</a>
				</div>
				<p class="cl2-trust">{l.trust}</p>
			</div>

			<div class="cl2-product-stage" aria-label="Converloop product preview">
				<div class="cl2-desktop">
					<div class="cl2-window-bar" aria-hidden="true"><i></i><i></i><i></i><span>{l.preview.desktopLabel}</span></div>
					<div class="cl2-desktop-body">
						<aside>
							<div class="cl2-mini-brand"><img src="/converloop-icon.png" width="26" height="26" alt="" /><b>C</b></div>
							{l.preview.sidebar.map((item, index) => <span class:list={{ active: index === 0 }}>{item}</span>)}
						</aside>
						<div class="cl2-chat-pane">
							<div class="cl2-chat-title"><b>{l.preview.conversation}</b><span>•••</span></div>
							<div class="cl2-chat-scroll">
								<p class="cl2-ai-bubble">{l.preview.aiLine}</p>
								<div class="cl2-user-bubble">
									<p>{l.preview.userPre}<del>{l.preview.userWrong}</del> <ins>{l.preview.userRight}</ins>{l.preview.userPost}</p>
									<span><b>{l.preview.userWrong}</b> → <strong>{l.preview.userRight}</strong></span>
									<small>{l.preview.correction}</small>
								</div>
								<div class="cl2-thinking"><i></i><i></i><i></i></div>
							</div>
							<div class="cl2-composer"><span>/</span><i></i><b>↑</b></div>
						</div>
					</div>
				</div>

				<div class="cl2-phone">
					<div class="cl2-phone-screen">
						<div class="cl2-phone-status"><span>9:41</span><i></i></div>
						<div class="cl2-phone-head"><b>‹</b><span>{l.preview.phoneLabel}</span><b>•••</b></div>
						<p class="cl2-phone-prompt">{l.preview.phonePrompt}</p>
						<p class="cl2-phone-reply">{l.preview.phoneReply}</p>
						<div class="cl2-chip-row">{l.preview.chips.map((chip) => <span>{chip}</span>)}</div>
						<div class="cl2-phone-compose"><i></i><span>⌁</span><b>↑</b></div>
						<div class="cl2-home-indicator"></div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="cl2-section cl2-loop">
		<div class="cl2-shell">
			<div class="cl2-section-head">
				<p class="cl2-kicker">{l.loop.kicker}</p>
				<h2>{l.loop.heading}</h2>
				<p>{l.loop.body}</p>
			</div>
			<div class="cl2-loop-grid">
				{l.loop.steps.map((step, index) => (
					<article>
						<div class="cl2-step-top"><span>{step.number}</span><i class:list={{ last: index === l.loop.steps.length - 1 }}></i></div>
						<h3>{step.title}</h3>
						<p>{step.body}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="cl2-section cl2-interactions-section">
		<div class="cl2-shell">
			<div class="cl2-section-head cl2-section-head--center">
				<p class="cl2-kicker">{s.kicker}</p>
				<h2>{s.heading}</h2>
				<p>{s.intro}</p>
			</div>

			<article class="cl2-correction-spotlight">
				<div class="cl2-interaction-copy">
					<span class="cl2-demo-number">01 · correction</span>
					<h3>{s.correction.title}</h3>
					<p>{s.correction.body}</p>
				</div>
				<div class="cl2-correction-demo" role="group" aria-label={s.correction.title}>
					<div class="cl2-demo-title"><span>{d.convo}</span><i></i></div>
					<div class="cl2-demo-conversation">
						<p class="cl2-demo-ai">{d.aiOpen}</p>
						<div class="cl2-demo-user">
							<p>{d.userPre}<del>{d.userDel}</del> <ins>{d.userIns}</ins>{d.userPost}</p>
							<div class="cl2-natural-version">
								<span aria-hidden="true">✦</span>
								<div><small>{s.correction.naturalLabel}</small><strong>{d.natural}</strong></div>
							</div>
						</div>
						<div class="cl2-grammar-card">
							<div><span>{d.issueCat}</span><small>{d.issueSev}</small></div>
							<p><del>{d.userDel}</del><b>→</b><ins>{d.userIns}</ins></p>
							<small>{d.issueExp}</small>
						</div>
						<p class="cl2-demo-ai">{d.reply}</p>
					</div>
				</div>
			</article>

			<div class="cl2-interaction-grid">
				<article class="cl2-interaction-card cl2-interaction-card--wide">
					<div class="cl2-interaction-copy">
						<span class="cl2-demo-number">02 · compose</span>
						<h3>{s.slash.title}</h3>
						<p>{s.slash.body}</p>
					</div>
					<div class="cl2-slash-demo" role="group" aria-label={s.slash.title}>
						<div class="cl2-slash-menu">
							{s.slash.rows.map((row, index) => (
								<div class:list={['cl2-slash-row', { selected: index === 0 }]}>
									<code>/{row.name}</code>
									{'args' in row && row.args && <span>{row.args}</span>}
									<small>{row.desc}</small>
								</div>
							))}
							<p class="cl2-slash-foot"><span aria-hidden="true">⌁</span>{s.slash.foot}</p>
						</div>
						<div class="cl2-showcase-input"><b>/</b><i></i><span>{s.slash.inputPlaceholder}</span><strong>↑</strong></div>
					</div>
				</article>

				<article class="cl2-interaction-card">
					<div class="cl2-interaction-copy">
						<span class="cl2-demo-number">03 · understand</span>
						<h3>{reply.title}</h3>
						<p>{reply.body}</p>
					</div>
					<div class="cl2-reply-demo" role="group" aria-label={reply.title}>
						<div class="cl2-bilingual-bubble">
							{reply.bubble.map((line) => <p><span>{line.target}</span><small>{line.native}</small></p>)}
						</div>
						<div class="cl2-reply-actions">
							<span>◖)) {reply.actions.speak}</span>
							<span class="active">◎ {reply.actions.explain}</span>
							<span class="active">文 {reply.actions.bilingual}</span>
						</div>
						<div class="cl2-explain-card"><b>{reply.explainLabel}</b><p>{reply.explainBody}</p></div>
					</div>
				</article>

				<article class="cl2-interaction-card">
					<div class="cl2-interaction-copy">
						<span class="cl2-demo-number">04 · explore</span>
						<h3>{s.selection.title}</h3>
						<p>{s.selection.body}</p>
					</div>
					<div class="cl2-selection-demo" role="group" aria-label={s.selection.title}>
						<p>{s.selection.sourcePre}<mark>{s.selection.sourceHl}</mark>{s.selection.sourcePost}</p>
						<div class="cl2-analysis-island">
							<div>
								<span class="active">⌁ {s.selection.actions.analyze}</span>
								<span>◖)) {s.selection.actions.speak}</span>
								<span>＋ {s.selection.actions.add}</span>
							</div>
							<b>{s.selection.sourceHl}</b>
							<p>{s.selection.analysis}</p>
						</div>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section class="cl2-section cl2-platform-section">
		<div class="cl2-shell">
			<div class="cl2-section-head cl2-section-head--center">
				<p class="cl2-kicker">{l.platforms.kicker}</p>
				<h2>{l.platforms.heading}</h2>
				<p>{l.platforms.body}</p>
			</div>
			<div class="cl2-platform-grid">
				{l.platforms.items.map((platform, index) => (
					<article class:list={['cl2-platform-card', `cl2-platform-card--${index + 1}`]}>
						<div class="cl2-platform-icon" aria-hidden="true">
							{index === 0 && <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>}
							{index === 1 && <svg viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="20" rx="3"/><path d="M10 18h4"/></svg>}
							{index === 2 && <svg viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M11 18h2"/></svg>}
						</div>
						<span class="cl2-platform-tag">{platform.tag}</span>
						<h3>{platform.title}</h3>
						<p>{platform.body}</p>
						<ul>{platform.points.map((point) => <li>{point}</li>)}</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="cl2-section cl2-features">
		<div class="cl2-shell">
			<div class="cl2-section-head">
				<p class="cl2-kicker">{l.features.kicker}</p>
				<h2>{l.features.heading}</h2>
			</div>
			<div class="cl2-feature-grid">
				{l.features.items.map((feature, index) => (
					<article>
						<span>{String(index + 1).padStart(2, '0')}</span>
						<div><h3>{feature.title}</h3><p>{feature.body}</p></div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="cl2-section cl2-continuity-section">
		<div class="cl2-shell cl2-continuity-grid">
			<div class="cl2-continuity-copy">
				<p class="cl2-kicker">{l.continuity.kicker}</p>
				<h2>{l.continuity.heading}</h2>
				<p>{l.continuity.body}</p>
				<div class="cl2-file" aria-hidden="true">
					<span>{'{ }'}</span>
					<div><b>{l.continuity.file}</b><small>converloop.portable-backup · v1</small></div>
					<i>JSON</i>
				</div>
			</div>
			<div class="cl2-continuity-points">
				{l.continuity.points.map((point, index) => (
					<article><span>{index + 1}</span><div><h3>{point.title}</h3><p>{point.body}</p></div></article>
				))}
			</div>
		</div>
	</section>

	<section class="cl2-section cl2-privacy-section">
		<div class="cl2-shell cl2-privacy">
			<div class="cl2-privacy-copy">
				<p class="cl2-kicker">{l.privacy.badge}</p>
				<h2>{l.privacy.heading}</h2>
				<p>{l.privacy.body}</p>
				<ul class="cl2-privacy-trust">{l.privacy.points.map((point) => <li><span>✓</span>{point}</li>)}</ul>
			</div>
			<div class="cl2-memory-boundary">
				<article class="cl2-memory-boundary-card cl2-memory-boundary-card--kept">
					<div><span aria-hidden="true">✓</span><h3>{l.privacy.keptTitle}</h3></div>
					<ul>{l.privacy.kept.map((item) => <li>{item}</li>)}</ul>
				</article>
				<article class="cl2-memory-boundary-card cl2-memory-boundary-card--private">
					<div><span aria-hidden="true">—</span><h3>{l.privacy.privateTitle}</h3></div>
					<ul>{l.privacy.private.map((item) => <li>{item}</li>)}</ul>
				</article>
			</div>
		</div>
	</section>

	<section class="cl2-section cl2-release-section">
		<div class="cl2-shell">
			<div class="cl2-section-head cl2-section-head--center">
				<p class="cl2-kicker">{l.release.kicker}</p>
				<h2>{l.release.heading}</h2>
				<p>{l.release.body}</p>
			</div>
			<div class="cl2-release-grid">
				<article class="cl2-release-card cl2-release-card--available">
					<span class="cl2-release-dot"></span>
					<div><h3>{l.release.macTitle}</h3><p>{l.release.macBody}</p></div>
					<a href={CONVERLOOP.releaseUrl} target="_blank" rel="noopener noreferrer">{l.download}<span>↗</span></a>
				</article>
				<article class="cl2-release-card">
					<span class="cl2-release-icon">⌁</span>
					<div><h3>{l.release.roadTitle}</h3><p>{l.release.roadBody}</p></div>
					<a href={CONVERLOOP.repoUrl} target="_blank" rel="noopener noreferrer">{l.source}<span>↗</span></a>
				</article>
			</div>

			<div class="cl2-faq">
				<h2>{l.faq.heading}</h2>
				<div>{l.faq.items.map((item) => <article><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
			</div>
		</div>
	</section>

	<section class="cl2-final">
		<div class="cl2-shell">
			<img src="/converloop-icon.png" width="80" height="80" alt="" />
			<h2>{l.final.heading}</h2>
			<p>{l.final.body}</p>
			<div class="cl2-actions cl2-actions--center">
				<a class="cl2-button cl2-button--primary" href={CONVERLOOP.releaseUrl} target="_blank" rel="noopener noreferrer"><strong>{l.download}</strong></a>
				<a class="cl2-button cl2-button--secondary" href={CONVERLOOP.repoUrl} target="_blank" rel="noopener noreferrer"><strong>{l.source}</strong></a>
			</div>
		</div>
	</section>
</ConverloopLayout>
